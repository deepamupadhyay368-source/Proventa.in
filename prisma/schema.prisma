datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

model User {
  id                String          @id @default(uuid())
  email             String          @unique
  passwordHash      String
  name              String
  role              String          @default("USER") // ADMIN, AUDITOR, USER, etc.
  organizationId    String?
  organization      Organization?   @relation(fields: [organizationId], references: [id])
  mfaSecret         String?
  mfaEnabled        Boolean         @default(false)
  recoveryCodes     String? // JSON array of backup hashes
  failedLogins      Int             @default(0)
  lockoutUntil      DateTime?
  passwordChangedAt DateTime        @default(now())
  passwordHistory   String? // JSON array of historical hashes
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  tickets           SupportTicket[]
  logs              AuditLog[]
  sessions          Session[]
}

model Organization {
  id                 String                @id @default(uuid())
  name               String
  subscriptionStatus String                @default("FREE_TRIAL") // FREE_TRIAL, ACTIVE, CANCELLED, PAST_DUE
  planType           String                @default("FREE") // FREE, PRO, ENTERPRISE
  encryptedDEK       String? // Encrypted Data Encryption Key for Envelope Encryption
  dekIV              String? // IV for the DEK
  keyRotatedAt       DateTime              @default(now())
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  users              User[]
  companies          CompanyProfile[]
  notifications      Notification[]
  tickets            SupportTicket[]
  apiKeys            ApiKey[]
  connections        FinancialConnection[]
  Customer           Customer[]
  Invoice            Invoice[]
  Alert              Alert[]
  AlertRule          AlertRule[]
  ForecastRecord     ForecastRecord[]
}

model CompanyProfile {
  id                String             @id @default(uuid())
  organizationId    String
  organization      Organization       @relation(fields: [organizationId], references: [id])
  name              String
  tradeName         String?
  cin               String?
  gstin             String?
  pan               String?
  legalType         String // PRIVATE_LIMITED, PROPRIETORSHIP, PARTNERSHIP, PUBLIC_LIMITED
  industry          String
  subIndustry       String?
  incorporationDate String?
  natureOfBusiness  String?
  regAddress        String
  opAddress         String?
  country           String
  state             String
  city              String
  pinCode           String
  website           String?
  email             String?
  phone             String?
  employeeCount     Int?
  annualRevenue     Float?
  annualTurnover    Float?
  productsServices  String?
  directors         String? // Semi-colon separated
  partners          String? // Semi-colon separated
  authSignatory     String?
  logoUrl           String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  documents         Document[]
  assessments       CreditAssessment[]
  litigations       Litigation[]
  CompanyEvent      CompanyEvent[]
}

model Document {
  id         String         @id @default(uuid())
  companyId  String
  company    CompanyProfile @relation(fields: [companyId], references: [id])
  name       String
  fileType   String // GST_CERT, PAN_CARD, COI, FINANCIAL_STMT, OTHER
  fileUrl    String
  fileSize   Int
  uploadedBy String
  createdAt  DateTime       @default(now())
}

model CreditAssessment {
  id               String         @id @default(uuid())
  companyId        String
  company          CompanyProfile @relation(fields: [companyId], references: [id])
  creditScore      Int // 300 to 900
  creditRating     String // AAA, AA, A, BBB, BB, B, C, D
  riskScore        Int // 0 to 100
  recommendedLimit Float
  assessmentData   String // JSON string with detailed metrics
  createdById      String
  createdAt        DateTime       @default(now())
}

model Litigation {
  id             String         @id @default(uuid())
  companyId      String
  company        CompanyProfile @relation(fields: [companyId], references: [id])
  caseNumber     String
  court          String
  status         String // PENDING, RESOLVED, DISMISSED
  amountDisputed Float
  description    String
  filingDate     String
  createdAt      DateTime       @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  userEmail String?
  action    String
  ipAddress String?
  details   String
  createdAt DateTime @default(now())
  User      User?    @relation(fields: [userId], references: [id])
}

model Notification {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  title          String
  message        String
  type           String       @default("INFO") // INFO, WARNING, ERROR, SUCCESS
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
}

model SupportTicket {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  subject        String
  message        String
  status         String       @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  priority       String       @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model ApiKey {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  keyHash        String
  status         String       @default("ACTIVE") // ACTIVE, REVOKED
  expiresAt      DateTime?
  ipWhitelist    String? // Comma-separated CIDR blocks
  scopes         String       @default("read:portfolio")
  createdAt      DateTime     @default(now())
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  orgId     String
  tokenHash String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FinancialConnection {
  id                   String       @id @default(uuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                 String
  category             String // BANKING, ACCOUNTING, ERP, CRM, TAX
  status               String // CONNECTED, FAILED, EXPIRED, PENDING
  encryptedCredentials String? // Encrypted with tenant DEK
  credentialsIV        String?
  syncSchedule         String       @default("DAILY")
  healthScore          Int          @default(100)
  lastSync             DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  syncJobs             SyncJob[]
}

model SyncJob {
  id              String              @id @default(uuid())
  connectionId    String
  connection      FinancialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  status          String // RUNNING, SUCCESS, FAILED
  recordsImported Int                 @default(0)
  errorMessage    String?
  startedAt       DateTime            @default(now())
  completedAt     DateTime?
}

model DataLakeItem {
  id             String   @id @default(uuid())
  organizationId String
  category       String // RAW, FEATURE, SNAPSHOT
  key            String
  value          String // JSON payload encrypted using tenant DEK
  version        Int      @default(1)
  createdAt      DateTime @default(now())
}

model WorkflowRule {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  trigger        String
  actions        String // JSON configuration
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
}

model WorkflowRun {
  id               String   @id @default(uuid())
  ruleId           String
  status           String // SUCCESS, FAILED, RUNNING
  executionHistory String // JSON log steps
  createdAt        DateTime @default(now())
}

model ReconciliationRecord {
  id                  String   @id @default(uuid())
  organizationId      String
  type                String // BANK_VS_LEDGER, GST_VS_SALES
  sourceAmount        Float
  targetAmount        Float
  difference          Float
  status              String // MATCHED, ANOMALY, RESOLVED
  anomalyReason       String?
  suggestedResolution String?
  createdAt           DateTime @default(now())
}

model TaskItem {
  id             String    @id @default(uuid())
  organizationId String
  assignedToId   String?
  title          String
  description    String?
  dueDate        DateTime?
  status         String    @default("OPEN") // OPEN, IN_PROGRESS, COMPLETED
  companyId      String?
  createdAt      DateTime  @default(now())
}

model CustomFieldConfig {
  id              String  @id @default(uuid())
  organizationId  String
  entityType      String // COMPANY, USER, TRANSACTION
  fieldName       String
  fieldType       String // TEXT, NUMBER, DROPDOWN
  validationRules String? // JSON
}

model AiConversation {
  id             String      @id @default(uuid())
  organizationId String
  userId         String
  title          String
  isPinned       Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  messages       AiMessage[]
}

model AiMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // USER, ASSISTANT
  content        String // Markdown payload
  citations      String? // JSON array of platform data references
  explainability String? // JSON payload: confidenceScore, reasoning, agentType
  feedbackRating Int?
  feedbackText   String?
  createdAt      DateTime       @default(now())
}

model AiRecommendation {
  id              String   @id @default(uuid())
  organizationId  String
  title           String
  description     String
  impact          String
  confidenceScore Int
  status          String   @default("ACTIVE") // ACTIVE, APPROVED, REJECTED
  actionTarget    String // Action detail JSON
  createdAt       DateTime @default(now())
}

model KnowledgeDocument {
  id             String   @id @default(uuid())
  organizationId String
  title          String
  content        String
  category       String // POLICY, SOP, MANUAL
  createdAt      DateTime @default(now())
}

model DataLakeSource {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  sourceType     String // API_SYNC, FILE_UPLOAD, MANUAL
  dataType       String // FINANCIAL_STATEMENT, TAX_RECORD, BANK_STATEMENT
  status         String // ACTIVE, PENDING, FAILED
  fileSize       Int?
  recordsCount   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model RetentionPolicy {
  id             String   @id @default(uuid())
  organizationId String
  policyCategory String
  policyDuration String
  policyAction   String // ARCHIVE, PURGE, RETAIN
  createdAt      DateTime @default(now())
}

model Waitlist {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  company   String
  industry  String
  revenue   Float
  priority  String
  position  Int
  createdAt DateTime @default(now())
}

model Customer {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  email          String?
  phone          String?
  gstin          String?
  pan            String?
  industry       String?
  annualRevenue  Float?
  creditLimit    Float?
  notes          String?
  riskScore      Int          @default(50)
  riskTier       String       @default("MEDIUM")
  dso            Float        @default(0)
  totalExposure  Float        @default(0)
  payOnTimeCount Int          @default(0)
  payLateCount   Int          @default(0)
  invoices       Invoice[]
  alerts         Alert[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Invoice {
  id             String       @id @default(uuid())
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  invoiceNumber  String
  description    String?
  amount         Float
  taxRate        Float        @default(0)
  dueDate        DateTime
  status         String       @default("DRAFT") // DRAFT, SENT, PAID, OVERDUE, CANCELLED
  paidAmount     Float        @default(0)
  paidDate       DateTime?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Alert {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type           String // SCORE_DROP, OVERDUE_INVOICE, COMPLIANCE_BREACH, SYSTEM
  title          String
  message        String
  severity       String       @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  isRead         Boolean      @default(false)
  isResolved     Boolean      @default(false)
  ruleId         String?
  rule           AlertRule?   @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model AlertRule {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  triggerType    String // SCORE_DROP, OVERDUE_DAYS, LIMIT_BREACH
  threshold      Float
  severity       String
  isActive       Boolean      @default(true)
  alerts         Alert[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model CompanyEvent {
  id          String         @id @default(uuid())
  companyId   String
  company     CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  eventType   String // DIRECTOR_CHANGE, GST_DELAY, LITIGATION, COMPLIANCE
  description String
  aiSummary   String?
  timestamp   DateTime       @default(now())
}

model ForecastRecord {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  forecastType   String
  period         String
  dataPoints     String
  summary        String
  insights       String
  generatedAt    DateTime     @default(now())
}
